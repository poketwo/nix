discovery.kubernetes "pods" { role = "pod" }
discovery.kubernetes "nodes" { role = "node" }

discovery.relabel "nodes" {
  targets = discovery.kubernetes.nodes.targets
  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label = "node"
  }
}

discovery.relabel "nodes_cadvisor" {
  targets = discovery.relabel.nodes.output
  rule {
    replacement   = "/metrics/cadvisor"
    target_label  = "__metrics_path__"
  }
}

discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    target_label = "node"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label = "app"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    target_label = "app"
  }
}

// Only scrape container ports that look like metrics endpoints; the plain
// pod targets include every port (redis, mongodb, grpc, ...), which Alloy
// would otherwise probe with HTTP every interval.
discovery.relabel "pods_metrics" {
  targets = discovery.relabel.pods.output
  rule {
    source_labels = ["__meta_kubernetes_pod_container_port_number"]
    regex = "[0-9]+"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_port_name"]
    regex = "metrics|.*-metrics|metrics-port|monitoring|http-monitoring|prometheus|http|grafana"
    action = "keep"
  }
}

//////////
// Loki //
//////////

loki.source.kubernetes "pods" {
  targets = discovery.relabel.pods.output
  forward_to = [loki.process.default.receiver]
  clustering { enabled = true }
}

loki.process "default" {
  stage.json {
    expressions = {
      level = "level",
      event = "event",
    }
  }
  stage.structured_metadata {
    values = {
      level = "",
      event = "",
    }
  }
  forward_to = [loki.write.default.receiver]
}

loki.source.kubernetes_events "default" {
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint { url = "http://loki-gateway.loki.svc.cluster.local/loki/api/v1/push" }
}

////////////////
// Prometheus //
////////////////

prometheus.scrape "pods" {
  targets = discovery.relabel.pods_metrics.output
  forward_to = [prometheus.remote_write.default.receiver]
  clustering { enabled = true }
}

prometheus.scrape "nodes_cadvisor" {
  targets = discovery.relabel.nodes_cadvisor.output
  forward_to = [prometheus.remote_write.default.receiver]
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  scheme = "https"
  tls_config {
    ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
    insecure_skip_verify = false
  }
  clustering { enabled = true }
}

prometheus.operator.servicemonitors "default" {
  forward_to = [prometheus.remote_write.default.receiver]
  clustering { enabled = true }
}

prometheus.operator.podmonitors "default" {
  forward_to = [prometheus.remote_write.default.receiver]
  clustering { enabled = true }
}

prometheus.operator.probes "default" {
  forward_to = [prometheus.remote_write.default.receiver]
  clustering { enabled = true }
}

prometheus.remote_write "default" {
  endpoint { url = "http://mimir-gateway.mimir.svc.cluster.local/api/v1/push" }
}

// Egress probes from the pod network, i.e. the path gateway and bot pods take:
// v4-only destinations go pod -> Cilium -> that node's Jool. Pairing NAT64
// targets with native IPv6 ones tells a Jool/upstream-IPv4 outage apart from
// the node losing the internet, and 8.8.8.8 tells a provider IPv4 fault apart
// from a Cloudflare/Discord one. Not clustered: every replica probes every
// target and labels the series with its own node.
prometheus.exporter.blackbox "egress" {
  config = `{"modules": {"tcp6": {"prober": "tcp", "timeout": "5s", "tcp": {"preferred_ip_protocol": "ip6", "ip_protocol_fallback": false}}}}`

  target {
    name    = "discord-gateway-nat64"
    address = "gateway.discord.gg:443"
    module  = "tcp6"
    labels  = { probe = "discord-gateway", path = "nat64" }
  }
  target {
    name    = "cloudflare-nat64"
    address = "[64:ff9b::101:101]:443"
    module  = "tcp6"
    labels  = { probe = "cloudflare", path = "nat64" }
  }
  target {
    name    = "cloudflare-ipv6"
    address = "[2606:4700:4700::1111]:443"
    module  = "tcp6"
    labels  = { probe = "cloudflare", path = "ipv6" }
  }
  target {
    name    = "google-nat64"
    address = "[64:ff9b::808:808]:443"
    module  = "tcp6"
    labels  = { probe = "google", path = "nat64" }
  }
  target {
    name    = "google-ipv6"
    address = "[2001:4860:4860::8888]:443"
    module  = "tcp6"
    labels  = { probe = "google", path = "ipv6" }
  }
}

discovery.relabel "egress" {
  targets = prometheus.exporter.blackbox.egress.targets
  rule {
    target_label = "node"
    replacement  = sys.env("K8S_NODE_NAME")
  }
}

prometheus.scrape "egress" {
  targets         = discovery.relabel.egress.output
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

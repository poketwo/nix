      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (schedule) (increase(velero_backup_duration_seconds_sum{schedule!=\"\"}[$__interval])) / sum by (schedule) (increase(velero_backup_duration_seconds_count{schedule!=\"\"}[$__interval]))",
          "legendFormat": "{{schedule}}",
          "range": true,
          "instant": false,
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      }
    },
